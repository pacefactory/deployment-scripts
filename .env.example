# Example .env for build.sh. build.sh regenerates .env from the profile
# settings it prompts for; only values that differ from the defaults need to be
# here. The full list of variables, defaults and where each one reaches is in
# docs/reference/environment-variables.md.

# PROJECT_PREFIX=

# WEBGUI_FORCE_GHOSTING=true
# One of: no_image, edges, edges_inverted, ghosted, ghosted_blur, color_invert
# WEBGUI_DEFAULT_GHOSTING_TYPE=ghosted
# DBSERVER_DISABLE_SNAPSHOT_IMAGES=true

# Pin image tags per service (default latest):
# REALTIME_TAG=latest
# AUDITGUI_TAG=latest
# GIFWRAPPER_TAG=latest
# DTREESERVER_TAG=latest

# MongoDB sizing (defaults scale with host RAM; see docs/reference/mongodb.md):
# MONGO_MEMORY_LIMIT=4g
# MONGO_WIREDTIGER_CACHE_GB=1.5

# Remote-training (expresso_server only):
# PF_EXPRESSO_PUBLIC_URL_BASE=https://site.example.com/api/expresso
# PF_REMOTE_TRAINER_URLS=https://siteB.example.com/api/expresso,https://siteC.example.com/api/expresso

# Idle-object snapshot archiving kill switch (expresso_server / celery_worker):
# PF_IDLE_ARCHIVE_ENABLED=true
