.env
.env.backup
install/
.vscode
.settings
docker-compose.custom.yml
docker-compose.yml
credentials/*/credentials.ini
credentials/*/fullchain.pem
credentials/*/privkey.pem
scripts/remote/servers.txt
scripts/remote/logs/
# SSL material created by scripts/import-ssl-cert.sh lives one level deeper,
# under credentials/ssl/live/<fqdn>/. Never commit real keys/certs or the
# source .pfx/.p12 bundles (the *.example templates are kept on purpose).
credentials/ssl/live/*/fullchain.pem
credentials/ssl/live/*/privkey.pem
credentials/ssl/live/*/privkey.pass
*.pfx
*.p12
# Reference deployment inputs are committed on purpose (docs/architecture/ARCHITECTURE_DOCS_STANDARD.md §4)
!docs/architecture/reference-deployments/*/.env
!docs/architecture/reference-deployments/*/.settings

# Release image staging output (scripts/release/stage.sh)
scripts/release/stage/
